# Supabase – obrázky portfolia (Storage)
# Získej v Supabase: Project Settings → API
# Pro lokální běh: zkopíruj do .env.local a doplň skutečné hodnoty.
NEXT_PUBLIC_SUPABASE_URL=https://tvoj-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tvuj-anon-public-klic

# Supabase (server-only) – pro DB + privátní Storage operace (NECOMMItovat)
SUPABASE_SERVICE_ROLE_KEY=tvuj-service-role-klic

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=nahodny-dlouhy-secret

# GitHub OAuth (Admin login)
GITHUB_ID=github-oauth-client-id
GITHUB_SECRET=github-oauth-client-secret

# Admin allowlist (jen tyto e-maily mají přístup do /admin)
ADMIN_EMAIL_ALLOWLIST=admin@example.com,admin2@example.com

# Kontaktní e-mail (volitelné, default: info@vizualio.cz)
# NEXT_PUBLIC_CONTACT_EMAIL=info@vizualio.cz
